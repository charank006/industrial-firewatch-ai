# Copy to backend/.env and fill in. `.env` is gitignored; this template is not.

# --- NASA FIRMS ------------------------------------------------------------
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Backend-only. NEVER expose this to frontend JavaScript (spec 3.1).
NASA_FIRMS_MAP_KEY=
FIRMS_MAP_KEY=

# Area of interest as west,south,east,north. Default = India nationwide.
FIRMS_AOI_BBOX=68.0,6.5,97.5,37.5
AOI_TIMEZONE=Asia/Kolkata
FIRMS_DAY_RANGE=3
FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,VIIRS_SNPP_NRT,MODIS_NRT

# --- Database --------------------------------------------------------------
# PostgreSQL + PostGIS:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/firewatch_db

# Tests use a SEPARATE database and must never point at DATABASE_URL:
TEST_DATABASE_URL=

# --- 7-Day Persistence Engine (GeoFlare Architecture) ----------------------
PERSISTENCE_DAYS=7
PERSISTENCE_RADIUS_METERS=500
PERSISTENCE_THRESHOLD=5

# --- Machine Learning Engine (LightGBM) ------------------------------------
ML_CONFIDENCE_THRESHOLD=0.40

# --- Alert Engine & Industrial Rules ---------------------------------------
INDUSTRIAL_ALERT_RADIUS_METERS=2000
INDUSTRIAL_ALERT_CONFIDENCE_THRESHOLD=0.60
ALERT_COOLDOWN_MINUTES=60
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# --- Background Scheduling -------------------------------------------------
SCHEDULER_ENABLED=true
FIRMS_ENABLED=true
# Polling interval in seconds (default 900 = 15 minutes, range 900-1800s):
FIRMS_POLL_INTERVAL_SECONDS=900
FIRMS_POLL_MINUTES=15
ANALYSIS_POLL_MINUTES=2
ANALYSIS_BATCH_SIZE=5
CONTAINMENT_SWEEP_HOURS=6
SCHEDULER_RUN_ON_STARTUP=false
LOG_LEVEL=INFO

# --- Admin -----------------------------------------------------------------
ADMIN_API_TOKEN=

# --- Fire event dedup thresholds -------------------------------------------
EVENT_LINK_RADIUS_M=1000
EVENT_LINK_WINDOW_HOURS=12
MAX_EVENT_EXTENT_KM=10
MAX_EVENT_DURATION_HOURS=168

# --- Frontend dev origin ---------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Notification Providers (SMS, Email, Push) -----------------------------
DEMO_MODE=true
FCM_PROJECT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@firewatch.ai
ALERT_RECIPIENT_EMAIL=
