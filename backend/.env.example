# Copy to backend/.env and fill in. `.env` is gitignored; this template is not.

# --- NASA FIRMS ------------------------------------------------------------
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Backend-only. NEVER expose this to frontend JavaScript (spec 3.1).
NASA_FIRMS_MAP_KEY=

# Area of interest as west,south,east,north. Default = Gujarat corridor.
FIRMS_AOI_BBOX=68.0,20.0,75.0,25.0
AOI_TIMEZONE=Asia/Kolkata
FIRMS_DAY_RANGE=1

# --- Database --------------------------------------------------------------
# Docker (docker-compose.yml) provisions the postgres/postgres role:
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/firewatch_db
# Homebrew postgres instead creates a role named after your macOS user:
#   brew install postgis && brew services start postgresql@17
#   createdb firewatch_db && psql firewatch_db -c 'CREATE EXTENSION postgis;'
DATABASE_URL=postgresql+asyncpg://YOUR_OS_USER@localhost:5432/firewatch_db

# Tests TRUNCATE between cases, so they use a SEPARATE database and must
# never point at DATABASE_URL. Defaults to <database>_test.
#   createdb firewatch_db_test && psql firewatch_db_test -c 'CREATE EXTENSION postgis;'
#   DATABASE_URL=...firewatch_db_test alembic upgrade head
TEST_DATABASE_URL=

# --- Background scheduling -------------------------------------------------
# Jobs run in-process on the API's event loop. Running more than one uvicorn
# worker would start one scheduler PER worker and poll FIRMS N times over -
# for multi-worker deployments set SCHEDULER_ENABLED=false and run
# `python -m app.workers.cli` from its own process instead.
SCHEDULER_ENABLED=true
FIRMS_POLL_MINUTES=5
ANALYSIS_POLL_MINUTES=2
ANALYSIS_BATCH_SIZE=5
CONTAINMENT_SWEEP_HOURS=6
# Run one ingest immediately at boot. Off by default so a restart during
# development does not spend FIRMS quota.
SCHEDULER_RUN_ON_STARTUP=false
LOG_LEVEL=INFO

# --- Admin -----------------------------------------------------------------
# Required by POST /api/admin/* so nobody else can burn the FIRMS quota.
ADMIN_API_TOKEN=

# --- Fire event dedup thresholds (spec 7) ---------------------------------
EVENT_LINK_RADIUS_M=1000
EVENT_LINK_WINDOW_HOURS=12
MAX_EVENT_EXTENT_KM=10
MAX_EVENT_DURATION_HOURS=168

# --- Frontend dev origin ---------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Notification providers (deferred - demo mode logs only) --------------
DEMO_MODE=true
FCM_PROJECT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@firewatch.ai
