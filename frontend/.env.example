# Data source: `api` (default) or `mock`.
# `api` needs the backend running on :8001. `mock` runs the dashboard from
# bundled fixtures with no backend at all - useful for UI work and demos.
VITE_DATA_SOURCE=api

# Left empty in dev: vite.config.ts proxies /api to the backend on :8001
VITE_API_BASE_URL=

# Backend WebSocket URL for Live Event Streaming
VITE_WS_URL=ws://localhost:8001/ws/events

# GIS Dark Matter Basemap Tile Provider (Free Carto tile fallback)
VITE_MAP_STYLE_URL=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png

# Esri Satellite Imagery Layer (Free World Imagery tile fallback)
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# (Optional) MapTiler / Mapbox Vector Key
VITE_MAPTILER_KEY=
