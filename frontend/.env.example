# Data source: `mock` (default) or `api`.
# Defaults to mock because the backend cannot yet supply classification, land
# cover or location names - those land in Phase 4/5. Switching early would show
# "Unknown Anomaly" on every card, a visible regression.
VITE_DATA_SOURCE=mock

# Left empty in dev: vite.config.ts proxies /api to the backend on :8001,
# so there is no cross-origin request and no CORS involved.
VITE_API_BASE_URL=
