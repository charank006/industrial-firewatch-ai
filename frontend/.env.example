# ==============================================================================
# GeoFlare AI — Frontend Environment Configuration (.env)
# ==============================================================================

# Backend API URL
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket URL for Live Event Streaming
VITE_WS_URL=ws://localhost:8000/ws/events

# GIS Dark Matter Basemap Tile Provider (Free Carto tile fallback)
VITE_MAP_STYLE_URL=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png

# Esri Satellite Imagery Layer (Free World Imagery tile fallback)
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# (Optional) MapTiler / Mapbox Vector Key if custom high-res vector tiles are desired
VITE_MAPTILER_KEY=
