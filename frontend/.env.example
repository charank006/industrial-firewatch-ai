# Data source: `api` (default) or `mock`.
# `api` needs the backend running on :8001. `mock` runs the dashboard from
# bundled fixtures with no backend at all - useful for UI work and demos.
VITE_DATA_SOURCE=api

# Left empty in dev: vite.config.ts proxies /api to the backend on :8001,
# so there is no cross-origin request and no CORS involved.
VITE_API_BASE_URL=
