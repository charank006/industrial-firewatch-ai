{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "firewatch-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "firewatch-backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--port", "8001", "--reload"],
      "cwd": "backend",
      "port": 8001
    }
  ]
}
